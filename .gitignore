# Python
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/

# Build outputs
dist/
build/
*.spec

# Runtime-only Koji assets; repository should keep only .gitkeep or README here.
assets/koji/*.png
assets/koji/*.webp
assets/koji/*.gif

# Runtime-only local AI files; do not commit binaries or model weights.
ai-runtime/*.exe
ai-runtime/*.gguf
ai-runtime/*.zip
ai-runtime/models/*.gguf
ai-runtime/models/**/*.gguf
ai-runtime/model_config.json

# Local user data
data/records.json
data/chat_history.json
data/notes.json
data/tags.json
data/pomodoro_stats.json
data/settings.json
data/*.tmp

# Binary release/runtime files
*.7z
*.rar
*.exe
*.gguf
*.zip
*.png
*.gif
*.webp
